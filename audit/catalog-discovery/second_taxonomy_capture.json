  },
  "excluded_sources": {
    "nhtsa_vpic_api": {
      "url": "https://vpic.nhtsa.dot.gov/api/vehicles/",
      "reason": "NHTSA VPIC API provides GetAllMakes (12,364 makes) and GetModelsForMakeId (e.g., 58 Toyota models) but lacks year and trim fields. DecodeVinValues requires VIN input and is not a catalog endpoint. No endpoint lists vehicles with make+model+year+trim without VIN knowledge.",
      "tested_endpoints": [
        {
          "endpoint": "GetAllMakes",
          "result": "12,364 makes, fields: Make_ID, Make_Name only"
        },
        {
          "endpoint": "GetModelsForMakeId/448",
          "result": "58 Toyota models, fields: Make_ID, Make_Name, Model_ID, Model_Name only"
        },
        {
          "endpoint": "DecodeVinValues/{vin}",
          "result": "Full decode (Make, Model, ModelYear, Trim, BasePrice, etc.) but requires VIN input"
        },
        {
          "endpoint": "GetVehicle/{id}",
          "result": "404 Not Found"
        },
        {
          "endpoint": "GetEquipmentPlantCodes",
          "result": "404 Not Found"
        }
      ],
      "verdict": "NOT suitable as taxonomy source - no catalog listing with year/trim"
    }
