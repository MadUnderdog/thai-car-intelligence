# Database
DATABASE_URL="postgresql://hermes:your-password@localhost:5432/thai_car_intelligence?schema=public"

# Admin API — fail-closed: if missing, /api/admin/* returns 401
ADMIN_API_TOKEN="change-me"

# AI / research (blank by default: deterministic unavailable mode; never calls a provider)
# All providers below use the openai-compatible adapter; set AI_PROVIDER="openai-compatible" for any of them.
AI_PROVIDER="" # openai-compatible (or openai)
AI_BASE_URL="" # e.g. https://api.openai.com/v1
AI_MODEL=""
AI_API_KEY=""

# --- OpenAI ---
# AI_PROVIDER="openai-compatible"
# AI_BASE_URL="https://api.openai.com/v1"
# AI_MODEL="gpt-4o"
# AI_API_KEY="sk-..."

# --- OpenRouter (OpenAI-compatible) ---
# AI_PROVIDER="openai-compatible"
# AI_BASE_URL="https://openrouter.ai/api/v1"
# AI_MODEL="openai/gpt-4o"
# AI_API_KEY="sk-or-..."

# --- OpenCode (OpenAI-compatible) ---
# AI_PROVIDER="openai-compatible"
# AI_BASE_URL="https://opencode.ai/zen/go/v1"
# AI_MODEL="mimo-v2.5"
# AI_API_KEY="..."
# DeepSeek flash (cheapest, requires China opt-in):
# AI_MODEL="deepseek/deepseek-v4-flash"
# MiniMax (expensive):
# AI_MODEL="minimax/minimax-m3"
EMBEDDING_PROVIDER="" # optional; openai-compatible (or openai)
EMBEDDING_BASE_URL="" # local internal service, e.g. http://localhost:8080 (no default is assumed)
EMBEDDING_MODEL="" # local service model label, e.g. bge-base
EMBEDDING_DIMENSIONS="768" # local /embed service returns 768; external providers may use 1536 in a separate vector strategy
EMBEDDING_API_KEY=""

# Object storage
STORAGE_PROVIDER=""
STORAGE_BUCKET=""
STORAGE_ENDPOINT=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# Crawler
CRAWLER_USER_AGENT="thai-car-intelligence-bot/0.1"
CRAWLER_REQUEST_DELAY_MS="1000"
CRAWLER_MAX_CONCURRENCY="2"
CRAWLER_TIMEOUT_MS="30000"
