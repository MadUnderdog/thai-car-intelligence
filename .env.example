# ===========================================
# Thai Car Intelligence — Environment Config
# ===========================================
# Copy this file to .env and fill in real values.
# NEVER commit .env or .env.local to git.

# === DATABASE (Required) ===
DATABASE_URL="postgresql://hermes:CHANGE_ME@localhost:5432/thai_car_intelligence?schema=public"

# Database connection details (used by lib/db.ts and src/lib/db-pg.ts)
DB_USER="hermes"
DB_HOST="localhost"
DB_PORT="5432"
DB_NAME="thai_car_intelligence"

# === ADMIN AUTH (Required) ===
# Fail-closed: if missing, /api/admin/* returns 401
ADMIN_API_TOKEN="change-me-to-a-random-secret"

# === AI / LLM PROVIDER (Optional — for future AI features) ===
# All providers use openai-compatible adapter
# Leave blank to disable AI (deterministic unavailable mode)
AI_PROVIDER=""                    # "openai-compatible" or "openai"
AI_BASE_URL=""                    # e.g. https://api.openai.com/v1
AI_API_KEY=""                     # Your API key
AI_MODEL=""                       # Default model
AI_SIMPLE_MODEL=""                # Model for simple tasks
AI_COMPLEX_MODEL=""               # Model for complex reasoning
AI_FAST_FALLBACK_MODEL=""         # Fast fallback model

# --- OpenAI Example ---
# AI_PROVIDER="openai-compatible"
# AI_BASE_URL="https://api.openai.com/v1"
# AI_MODEL="gpt-4o"
# AI_API_KEY="sk-..."

# --- OpenRouter Example ---
# AI_PROVIDER="openai-compatible"
# AI_BASE_URL="https://openrouter.ai/api/v1"
# AI_MODEL="openai/gpt-4o"
# AI_API_KEY="sk-or-..."

# --- OpenCode Example ---
# AI_PROVIDER="openai-compatible"
# AI_BASE_URL="https://opencode.ai/zen/go/v1"
# AI_MODEL="mimo-v2.5"
# AI_API_KEY="..."

# === EMBEDDING (Optional — for vector search) ===
EMBEDDING_PROVIDER=""             # "openai-compatible" or "openai"
EMBEDDING_BASE_URL=""             # e.g. http://localhost:8080 (local) or provider URL
EMBEDDING_MODEL=""                # e.g. bge-base, text-embedding-3-small
EMBEDDING_DIMENSIONS="768"        # 768 for local BGE, 1536 for OpenAI
EMBEDDING_API_KEY=""              # API key (if required)

# === STORAGE (Optional — for future file storage) ===
STORAGE_PROVIDER=""               # s3, gcs, etc.
STORAGE_BUCKET=""                 # Bucket name
STORAGE_ENDPOINT=""               # S3-compatible endpoint
STORAGE_REGION=""                 # e.g. us-east-1
STORAGE_ACCESS_KEY_ID=""          # Access key
STORAGE_SECRET_ACCESS_KEY=""      # Secret key

# === CRAWLER (Optional — for research crawling) ===
CRAWLER_USER_AGENT="thai-car-intelligence-bot/0.1"
CRAWLER_REQUEST_DELAY_MS="1000"   # Delay between requests (ms)
CRAWLER_MAX_CONCURRENCY="2"       # Max parallel requests
CRAWLER_TIMEOUT_MS="30000"        # Request timeout (ms)
