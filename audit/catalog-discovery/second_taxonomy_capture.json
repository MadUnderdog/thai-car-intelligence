      "variant": "optional variant field in schema",
      "powertrain": "drivetrain, motor config, power, torque",
      "battery": "chemistry, capacity, thermal management, warranty",
      "charging": "AC/DC power, connectors, protocols",
      "range": "WLTP/EPA rated range",
      "performance": "0-100, top speed",
      "pricing": "MSRP by country/currency",
      "sources": "cited source URLs per record"
    },
