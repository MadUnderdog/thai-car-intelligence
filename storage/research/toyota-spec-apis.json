  "usage_example": {
    "description": "To get spec data for any Toyota Thailand model:",
    "steps": [
      "1. Get series codes from POST /component/api/tcoth/web-init (returns car_series with codes)",
      "2. OR get all series from GET /en/model/api/car-series/ (grouped by category)",
      "3. Fetch full model+spec data from GET /en/model/api/car/?series_code={code}",
      "4. Parse data[0].grades[].specifications[] for detailed specs",
      "5. Specifications are in Thai — use title_en for English labels"
    ],
    "sample_series_codes": [
